rules_version='2'

// These rules govern the browser SDK only. Server code uses the Admin SDK,
// which bypasses them (it creates profiles and reads other users' routes for
// conflict checks).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // One profile per user, keyed by uid. The uid field can't be changed to
    // point at someone else.
    match /userprofiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
    }

    // Routes belong to whoever's uid is on them.
    match /routes/{routeId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}
